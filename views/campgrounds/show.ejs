<% layout('layouts/boilerplate') -%>

    <link rel="stylesheet" href="/stylesheets/stars.css" />


    <div class='row'>
        <div class="col-6">
            <div id="CampgroundcarouselControls"" class=" carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    <% campground.images.forEach((img, i)=> { %>
                        <div class="carousel-item <%=i===0 ? 'active' : ' '%>"">
                                <img src=" <%=img.url%>" class="d-block w-100" alt="">
                        </div>
                        <% }) %>
                </div>
                <% if (campground.images.length> 1) { %>
                    <button class="carousel-control-prev" type="button" data-bs-target="#CampgroundcarouselControls""
                            data-bs-slide=" prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#CampgroundcarouselControls"
                        data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                    <% } %>
            </div>
            <div class='card mb-3'>
                <div class="card-body">
                    <h5 class="card-title">
                        <%=campground.title%>
                    </h5>
                    <% if (campground.reviews.length) {%>
                        <p class="starability-result" data-rating="<%= campground.avgRating%>"> Rated:
                            <%=campground.avgRating%>
                        </p>
                        <% } %>
                            <p class=' card-text'>
                                Submitted By: @<%= campground.author.username %>
                            </p>
                            <p class="card-text">
                                <%=campground.description%>
                            </p>
                </div>
                <div id='map'></div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item text-muted">
                        <%=campground.city%>, <%=campground.state%>
                    </li>
                    <li class="list-group-item">$<%=campground.price%>/night</li>
                </ul>
                <div class='card-body'>
                    <% if(currentUser && campground.author.equals(currentUser)) { %>
                        <a class='card-link btn btn-dark' role='button'
                            href='/campgrounds/<%=campground._id%>/edit'>Edit</a>
                        <form class='d-inline' method='POST' action='/campgrounds/<%=campground._id%>?_method=DELETE'>
                            <button class="card-link btn btn-danger">Delete</button>
                        </form>
                        <% } %>
                            <div>
                                <a href='/campgrounds'>Back To All Campgrounds</a>
                            </div>
                </div>
                <div class="card-footer">
                    2 days ago
                </div>
            </div>
        </div>

        <div class='col-6'>
            <% for (let review of campground.reviews) { %>
                <div class=' card mb-3'>
                    <div class='card-body'>
                        <h5>@<%= review.author.username%>
                        </h5>
                        <p class="starability-result" data-rating="<%= review.rating%>"> Rated: <%= review.rating%>
                        </p>
                        <p class='card-text'>Review: <%=review.body%>
                        </p>
                    </div>
                    <% if (currentUser && review.author.equals(currentUser)) { %>
                        <div class='card-body'>
                            <form class='d-inline' method='POST'
                                action='/campgrounds/<%=campground._id%>/reviews/<%=review.id%>?_method=DELETE'>
                                <button class="card-link btn btn-danger">Delete</button>
                            </form>
                        </div>
                        <% } %>
                </div>
                <% } %>
        </div>
    </div>

    <div class='row'>
        <div class='col-6'>
            <% if(currentUser) { %>
                <div class='card mb-3'>
                    <div class='card-body'>
                        <h2 class='h2'>Leave A Review</h2>
                        <form method='POST' action='/campgrounds/<%=campground._id%>/reviews' novalidate
                            class='validated-form'>
                            <div class='form-check-inline'>
                                <fieldset class="starability-basic">
                                    <input type="radio" id="no-rate" class="input-no-rate" name="rating" value="0"
                                        checked aria-label="No rating." />
                                    <input type="radio" id="first-rate1" name="rating" value="1" />
                                    <label for="first-rate1" title="Terrible">1 star</label>
                                    <input type="radio" id="first-rate2" name="rating" value="2" />
                                    <label for="first-rate2" title="Not good">2 stars</label>
                                    <input type="radio" id="first-rate3" name="rating" value="3" />
                                    <label for="first-rate3" title="Average">3 stars</label>
                                    <input type="radio" id="first-rate4" name="rating" value="4" />
                                    <label for="first-rate4" title="Very good">4 stars</label>
                                    <input type="radio" id="first-rate5" name="rating" value="5" />
                                    <label for="first-rate5" title="Amazing">5 stars</label>
                                </fieldset>
                            </div>
                            <div class='mb-3'>
                                <label for='body' class='form-label'>Review:</label>
                                <textarea name='body' id='body' class='form-control' cols='30' rows='5'
                                    required></textarea>
                                <div class="valid-feedback">
                                    Looks good!
                                </div>
                                <div class='mb-3'>
                                    <button class='btn btn-success'>Submit Review</button>
                                </div>
                        </form>
                    </div>
                </div>

                <% } else { %>
                    <div class='mb-3'>
                        <a class='btn btn-danger' href='/login'>Login To Write A Review</a>
                    </div>
                    <% } %>
        </div>
    </div>


    <script>
        const mapToken = '<%-process.env.MAPBOX_TOKEN%>';
        let campground = <%-JSON.stringify(campground) %>
    </script>

    <script src='/javascripts/showPageMap.js'></script>