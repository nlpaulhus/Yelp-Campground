<% layout('layouts/boilerplate') -%>

    <div class='row'>
        <h1 class='text-center'>Edit Review</h1>
        <div class='col-6 off set-3'>
            <form method='POST' action='/campgrounds/<%=campground._id%>/reviews/<%=review._id%>/edit?_method=PATCH'
                novalidate class='validated-form'>
                <div class='mb-3'>
                    <label for='rating' class='form-label'>Rating:</label>
                    <input type="range" class='form-range' name='rating' id='rating' min='1' max='5' required>
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                </div>
                <div class='mb-3'>
                    <label for='body' class='form-label'>Review:</label>
                    <textarea name='body' id='body' class='form-control' cols='30' rows='5'
                        required><%=review.body%></textarea>
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                    <div class='mb-3'>
                        <button type='submit' class='btn-dark'>Submit</button>
                    </div>
            </form>
            <div>
                <a href='/campgrounds/<%=campground._id%>'>Back To Campground</a>
            </div>